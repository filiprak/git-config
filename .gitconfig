[user]
	name = Filip Rak
	email = filip.rak@ikol.com
[core]
	autocrlf = false
[alias]
	stash-unapply = !git stash show -p | git apply -R
	c = commit
	cl = !SKIP_HOOKS=1 git commit -am 'chore: cleanup implementation'
	w = !SKIP_HOOKS=1 git commit -am 'chore: work in progress'
	ws = !SKIP_HOOKS=1 git commit -am 'chore: work in progress [skip ci]'
	cls = !SKIP_HOOKS=1 git commit -am 'chore: cleanup implementation [skip ci]'
	i = !git uo && git u
	s = status
	l = log --oneline
	xc = reset HEAD^1
	u = !git um && git pull origin master
	d = diff
	p = push origin HEAD
	um = pull origin master:master
	f = fetch
	current = rev-parse --abbrev-ref HEAD
	uo = !CURRENT=$(git current) && git pull origin $CURRENT
	lmsg = log --format=%B -n 1
	sci = !CMSG="\"$(git lmsg) [skip ci]\"" && SKIP_HOOKS=1 git commit --amend --no-edit -m "\"$CMSG\""
	m = checkout master
    mm = !git checkout master && git pull origin master && echo '>>> Resetting via ssh to master' && ssh "$SSH_GIT_DEVREPO" 'cd ~/www && git fetch origin && git checkout -- . && git clean -fd && git checkout master && git reset --hard origin/master && git pull origin master'
	bb = "!f() { BRANCH=$(git branch --show-current) && echo \">>> Resetting via ssh to $BRANCH\" && ssh "$SSH_GIT_DEVREPO" 'cd ~/www && git fetch origin && git checkout -- . && git clean -fd && git checkout '\"$BRANCH\"' && git reset --hard origin/'\"$BRANCH\"' && git pull origin '\"$BRANCH\"''; }; f"
